{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasks",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "completed": {
      "type": "boolean"
    },
    "user": {
      "type": "string",
      "description": "Reference to the Firestore user document that owns this task"
    }
  },
  "required": [
    "title",
    "completed",
    "user"
  ]
}
